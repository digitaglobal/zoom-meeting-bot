# Local use only: the bot reads these from a ".env" in this folder (or the project's ../.env.local).
# Never commit real values. On GitHub the login is the secret ZOOM_SESSION instead (see README).
# Keep each comment on its own line: a comment after a value would become part of the value.

# The Zoom account the bot signs in as (this is who starts the meeting and is "the host")
ZOOM_USERNAME=
ZOOM_PASSWORD=

# The permanent way in, instead of ZOOM_USERNAME/ZOOM_PASSWORD (all six, or none; see README, "No login at all"). A Zoom login
# dies about 15 hours after sign-in; these API credentials never expire. On GitHub they are secrets with the same names.
ZOOM_ACCOUNT_ID=
ZOOM_S2S_CLIENT_ID=
ZOOM_S2S_CLIENT_SECRET=
ZOOM_SDK_KEY=
ZOOM_SDK_SECRET=
# the e-mail address of the Zoom user who owns the meetings
ZOOM_HOST_EMAIL=

# Who gets host. Not case sensitive; "kemal" and "Kemal" both match "Kemal Example".
NEW_HOST_NAME=Kemal

# How long to wait for the new host to arrive (seconds). Default 1800 (30 minutes).
WAIT_FOR_NEW_HOST_SECONDS=1800

# Schedule check ("npm run tick"). Default .* = every meeting. A pattern (for example: interview) limits it to matching titles.
MEETING_FILTER=.*
# Start the meeting this many minutes before it begins.
LEAD_MINUTES=10
# A run that is late still starts a meeting up to this many minutes after its start time. Keep it short: Zoom lists a
# meeting that already finished with a Start button again, and it must not be started twice.
LATE_MINUTES=5
ZOOM_TIMEZONE=America/Jamaica

# Optional: path to Chrome or Edge if it is not found automatically
CHROME_PATH=
# 0 = run hidden (default), 1 = show the browser window (use this if Zoom ever asks for a code or captcha)
HEADED=0

# Optional: a secret https address the bot reports to after a real hand-over, and when a run fails (for example a Pabbly
# "catch webhook"). On GitHub this is the secret REPORT_WEBHOOK_URL. Never commit a real value.
REPORT_WEBHOOK_URL=
